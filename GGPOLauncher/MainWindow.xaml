<Window x:Class="GGPOLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="King of the Colony - GGPO Launcher"
        Height="760"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#111827">

    <Window.Resources>
        <Style x:Key="AccentButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#0F766E"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="18,12"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#0D9488"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Background"
                                        Value="#374151"/>
                                <Setter Property="Foreground"
                                        Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#1F2937"/>
            <Setter Property="CornerRadius"
                    Value="12"/>
            <Setter Property="Padding"
                    Value="18"/>
            <Setter Property="Margin"
                    Value="0,0,0,14"/>
        </Style>

        <Style x:Key="StatusText"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#E5E7EB"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="PanelLogin">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#0B1020"
                                  Offset="0"/>
                    <GradientStop Color="#1F2937"
                                  Offset="0.55"/>
                    <GradientStop Color="#134E4A"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Width="980"
                  Height="580"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="22,0,0,22"
                        Background="#F3F4F6"
                        Padding="40">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="King of the Colony"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="Plataforma centralizada para autenticación, cola de retadores, ranking histórico y transparencia de turnos."
                                   Margin="0,16,0,0"
                                   FontSize="18"
                                   Foreground="#374151"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="El servidor controla créditos, espectadores, jugadores activos y el próximo desafío al rey."
                                   Margin="0,20,0,0"
                                   FontSize="16"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"/>

                        <Border Background="#D1FAE5"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,30,0,0">
                            <StackPanel>
                                <TextBlock Text="Lo que agrega esta versión"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#065F46"/>
                                <TextBlock Text="• Inicio de sesión con Google"
                                           Margin="0,10,0,0"
                                           Foreground="#065F46"/>
                                <TextBlock Text="• Sala en tiempo real con cola y espectadores"
                                           Margin="0,6,0,0"
                                           Foreground="#065F46"/>
                                <TextBlock Text="• Perfil, créditos y ranking histórico"
                                           Margin="0,6,0,0"
                                           Foreground="#065F46"/>
                                <TextBlock Text="• Transparencia total de quién sigue"
                                           Margin="0,6,0,0"
                                           Foreground="#065F46"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        CornerRadius="0,22,22,0"
                        Background="#111827"
                        Padding="34">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="Acceso"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Inicia sesión para sincronizar tu perfil, créditos y posición en cola."
                                       Margin="0,12,0,0"
                                       FontSize="15"
                                       Foreground="#9CA3AF"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>

                            <Border Style="{StaticResource CardBorder}"
                                    Background="#0F172A"
                                    Margin="0,28,0,0">
                                <StackPanel>
                                    <TextBlock Text="Servidor API"
                                               Foreground="#E5E7EB"
                                               FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtApiBaseUrl"
                                             Margin="0,10,0,0"
                                             Height="38"
                                             Text="http://localhost:5153"
                                             Padding="10,6"
                                             Background="#1F2937"
                                             Foreground="#F9FAFB"
                                             BorderBrush="#374151"/>
                                    <TextBlock Text="Usa la URL base del backend ASP.NET Core."
                                               Margin="0,10,0,0"
                                               Foreground="#9CA3AF"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}"
                                    Background="#0F172A"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Acceso con correo"
                                               Foreground="#E5E7EB"
                                               FontWeight="SemiBold"
                                               FontSize="16"/>
                                    <TextBlock x:Name="TxtAuthModeHint"
                                               Text="Ingresa con tu cuenta existente para ver tu perfil y tu posición en la cola."
                                               Margin="0,8,0,0"
                                               Foreground="#9CA3AF"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnShowLoginMode"
                                                Grid.Column="0"
                                                Content="Ya tengo cuenta"
                                                Style="{StaticResource AccentButton}"
                                                Background="#0F766E"
                                                Click="BtnShowLoginMode_Click"/>
                                        <Button x:Name="BtnShowRegisterMode"
                                                Grid.Column="1"
                                                Content="Quiero registrarme"
                                                Style="{StaticResource AccentButton}"
                                                Background="#374151"
                                                Click="BtnShowRegisterMode_Click"/>
                                    </Grid>

                                    <Border x:Name="CardLoginMode"
                                            Background="#111827"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Correo electrónico"
                                                       Foreground="#D1D5DB"
                                                       FontSize="12"/>
                                            <TextBox x:Name="TxtEmailLogin"
                                                     Margin="0,6,0,0"
                                                     Height="38"
                                                     Padding="10,6"
                                                     Background="#1F2937"
                                                     Foreground="#F9FAFB"
                                                     BorderBrush="#374151"
                                                     ToolTip="ejemplo@correo.com"/>
                                            <TextBlock Text="Clave"
                                                       Margin="0,10,0,0"
                                                       Foreground="#D1D5DB"
                                                       FontSize="12"/>
                                            <PasswordBox x:Name="PwdLogin"
                                                         Margin="0,6,0,0"
                                                         Height="38"
                                                         Padding="10,6"
                                                         Background="#1F2937"
                                                         Foreground="#F9FAFB"
                                                         BorderBrush="#374151"/>
                                            <TextBlock Text="Usa el mismo correo con el que registraste tu perfil."
                                                       Margin="0,10,0,0"
                                                       Foreground="#9CA3AF"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                            <Button x:Name="BtnEmailLogin"
                                                    Content="Entrar con correo"
                                                    Style="{StaticResource AccentButton}"
                                                    Margin="0,14,0,0"
                                                    Click="BtnEmailLogin_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="CardRegisterMode"
                                            Visibility="Collapsed"
                                            Background="#111827"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Nombre visible"
                                                       Foreground="#D1D5DB"
                                                       FontSize="12"/>
                                            <TextBox x:Name="TxtRegisterDisplayName"
                                                     Margin="0,6,0,0"
                                                     Height="38"
                                                     Padding="10,6"
                                                     Background="#1F2937"
                                                     Foreground="#F9FAFB"
                                                     BorderBrush="#374151"
                                                     ToolTip="Nombre que verán en ranking y cola"/>
                                            <TextBlock Text="Correo electrónico"
                                                       Margin="0,10,0,0"
                                                       Foreground="#D1D5DB"
                                                       FontSize="12"/>
                                            <TextBox x:Name="TxtRegisterEmail"
                                                     Margin="0,6,0,0"
                                                     Height="38"
                                                     Padding="10,6"
                                                     Background="#1F2937"
                                                     Foreground="#F9FAFB"
                                                     BorderBrush="#374151"
                                                     ToolTip="ejemplo@correo.com"/>
                                            <TextBlock Text="Crea una clave"
                                                       Margin="0,10,0,0"
                                                       Foreground="#D1D5DB"
                                                       FontSize="12"/>
                                            <PasswordBox x:Name="PwdRegister"
                                                         Margin="0,6,0,0"
                                                         Height="38"
                                                         Padding="10,6"
                                                         Background="#1F2937"
                                                         Foreground="#F9FAFB"
                                                         BorderBrush="#374151"/>
                                            <TextBlock Text="Confirma tu clave"
                                                       Margin="0,10,0,0"
                                                       Foreground="#D1D5DB"
                                                       FontSize="12"/>
                                            <PasswordBox x:Name="PwdRegisterConfirm"
                                                         Margin="0,6,0,0"
                                                         Height="38"
                                                         Padding="10,6"
                                                         Background="#1F2937"
                                                         Foreground="#F9FAFB"
                                                         BorderBrush="#374151"/>
                                            <TextBlock Text="La clave debe tener al menos 8 caracteres. Al crear la cuenta entrarás automáticamente."
                                                       Margin="0,10,0,0"
                                                       Foreground="#9CA3AF"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                            <Button x:Name="BtnRegisterEmail"
                                                    Content="Crear cuenta y entrar"
                                                    Style="{StaticResource AccentButton}"
                                                    Margin="0,14,0,0"
                                                    Background="#2563EB"
                                                    Click="BtnRegisterEmail_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="o continúa con Google"
                                       Margin="0,2,0,0"
                                       Foreground="#6B7280"
                                       FontSize="12"
                                       HorizontalAlignment="Center"/>

                            <Button x:Name="BtnGoogleLogin"
                                    Content="Iniciar sesión con Google"
                                    Style="{StaticResource AccentButton}"
                                    Margin="0,12,0,0"
                                    Click="BtnGoogleLogin_Click"/>
                            <TextBlock x:Name="TxtLoginStatus"
                                       Margin="0,16,0,0"
                                       Style="{StaticResource StatusText}"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="PanelDashboard"
              Visibility="Collapsed"
              Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0F172A"
                    CornerRadius="14"
                    Padding="18"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="TxtWelcome"
                                   Text="Bienvenido"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#F9FAFB"/>
                        <TextBlock x:Name="TxtHeaderSummary"
                                   Margin="0,8,0,0"
                                   FontSize="14"
                                   Foreground="#9CA3AF"/>
                        <TextBlock x:Name="TxtActiveMatchBanner"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="#A7F3D0"
                                   Text="No hay partida en seguimiento."/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Actualizar"
                                Style="{StaticResource AccentButton}"
                                Click="BtnRefreshDashboard_Click"/>
                        <Button Content="Ir al Launcher"
                                Style="{StaticResource AccentButton}"
                                Background="#2563EB"
                                Click="BtnOpenLauncher_Click"/>
                        <Button Content="Cerrar sesión"
                                Style="{StaticResource AccentButton}"
                                Background="#7C2D12"
                                Click="BtnLogout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,16,0">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Tu perfil"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB"/>
                            <TextBlock x:Name="TxtProfileName"
                                       Margin="0,14,0,0"
                                       Foreground="#E5E7EB"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtProfileEmail"
                                       Margin="0,6,0,0"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtProfileStats"
                                       Margin="0,12,0,0"
                                       Foreground="#D1D5DB"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtCredits"
                                       Margin="0,12,0,0"
                                       Foreground="#FDE68A"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,16,0,0">
                                <Button Content="+1 crédito"
                                        Style="{StaticResource AccentButton}"
                                        Click="BtnAddOneCredit_Click"/>
                                <Button Content="+5 créditos"
                                        Style="{StaticResource AccentButton}"
                                        Background="#2563EB"
                                        Click="BtnAddFiveCredits_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Historial reciente de créditos"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB"/>
                            <ListBox x:Name="ListCreditHistory"
                                     Margin="0,12,0,0"
                                     Height="220"
                                     Background="#111827"
                                     Foreground="#E5E7EB"
                                     BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,16,0">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sala actual"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#F9FAFB"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <Button Content="Crear sala"
                                            Style="{StaticResource AccentButton}"
                                            Click="BtnCreateRoom_Click"/>
                                    <Button Content="Espectar"
                                            Style="{StaticResource AccentButton}"
                                            Background="#2563EB"
                                            Click="BtnSpectateSelectedRoom_Click"/>
                                    <Button Content="Entrar a cola"
                                            Style="{StaticResource AccentButton}"
                                            Background="#9333EA"
                                            Click="BtnJoinQueueSelectedRoom_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtRoomStatus"
                                       Margin="0,14,0,0"
                                       Foreground="#F3F4F6"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtKingInfo"
                                       Margin="0,10,0,0"
                                       Foreground="#FCD34D"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtChallengerInfo"
                                       Margin="0,8,0,0"
                                       Foreground="#93C5FD"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtSpectatorCount"
                                       Margin="0,8,0,0"
                                       Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtActiveMatchState"
                                       Margin="0,8,0,0"
                                       Foreground="#A7F3D0"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Cola visible"
                                       Margin="0,18,0,0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB"/>
                            <ListBox x:Name="ListQueue"
                                     Margin="0,10,0,0"
                                     Height="180"
                                     Background="#111827"
                                     Foreground="#E5E7EB"
                                     BorderThickness="0"/>
                            <TextBlock x:Name="TxtRealtimeStatus"
                                       Margin="0,14,0,0"
                                       Foreground="#A7F3D0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Salas activas"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB"/>
                            <ListBox x:Name="ListRooms"
                                     Margin="0,12,0,0"
                                     Height="220"
                                     Background="#111827"
                                     Foreground="#E5E7EB"
                                     BorderThickness="0"
                                     SelectionChanged="ListRooms_SelectionChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Ranking histórico"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB"/>
                            <ListBox x:Name="ListRanking"
                                     Margin="0,14,0,0"
                                     Height="470"
                                     Background="#111827"
                                     Foreground="#E5E7EB"
                                     BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="PanelLegacyLauncher"
              Visibility="Collapsed">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Content="Volver al Dashboard"
                        Width="190"
                        Style="{StaticResource AccentButton}"
                        Click="BtnBackToDashboard_Click"/>

                <Grid Grid.Row="1"
                      Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="PanelHost"
                                Grid.Column="0"
                                Width="500"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Crear Partida (Host)"
                                   Foreground="#CDD6F4"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>
                        <Border Background="#313244"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,16">
                            <TextBlock x:Name="TxtHostInstruction"
                                       Style="{StaticResource StatusText}"
                                       Text="Para crear una partida, asegúrate de haber abierto el puerto 6000 (UDP y TCP) en la configuración de tu router (Port Forwarding). Tu IP pública actual es: Obteniendo... Compártela con tu amigo."/>
                        </Border>
                        <TextBlock x:Name="TxtHostStatus"
                                   Style="{StaticResource StatusText}"
                                   HorizontalAlignment="Center"
                                   Text=""/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <Button x:Name="BtnStartHost"
                                    Content="Iniciar Host"
                                    Style="{StaticResource AccentButton}"
                                    Click="BtnStartHost_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="PanelClient"
                                Grid.Column="1"
                                Width="500"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Unirse a Partida"
                                   Foreground="#CDD6F4"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>
                        <Border Background="#313244"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource StatusText}"
                                       Text="Ingresa la dirección IP que te dio tu amigo para conectarte a su partida."/>
                        </Border>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,16">
                            <TextBox x:Name="TxtHostIp"
                                     Width="300"
                                     Height="36"
                                     FontSize="16"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     Background="#45475A"
                                     Foreground="#CDD6F4"
                                     BorderBrush="#585B70"
                                     CaretBrush="#CDD6F4"/>
                            <Button x:Name="BtnConnect"
                                    Content="Conectar"
                                    Style="{StaticResource AccentButton}"
                                    Margin="12,0,0,0"
                                    Click="BtnConnect_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtClientStatus"
                                   Style="{StaticResource StatusText}"
                                   HorizontalAlignment="Center"
                                   Text=""/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
