<Window x:Class="GGPOLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="King of the Colony - GGPO Launcher"
        Height="600"
        Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#1E1E2E">

    <Window.Resources>
        <Style x:Key="AccentButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#4A90D9"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="20,12"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#5BA0E9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Background"
                                        Value="#555"/>
                                <Setter Property="Foreground"
                                        Value="#999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusText"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#CDD6F4"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="Margin"
                    Value="0,8,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Role Selection Panel -->
        <StackPanel x:Name="PanelRoleSelection"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="KOF 2002 - GGPO Launcher"
                       Foreground="#CDD6F4"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBlock Text="Selecciona tu rol para comenzar:"
                       Foreground="#A6ADC8"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="Crear Partida (Host)"
                        Style="{StaticResource AccentButton}"
                        Margin="0,0,20,0"
                        Click="BtnHost_Click"/>

                <Button Content="Unirse a Partida"
                        Style="{StaticResource AccentButton}"
                        Background="#A6E3A1"
                        Foreground="#1E1E2E"
                        Click="BtnClient_Click"/>
            </StackPanel>

            <Button x:Name="BtnDiagnostic"
                    Content="Validar Requisitos del Sistema"
                    Style="{StaticResource AccentButton}"
                    Background="#F9E2AF"
                    Foreground="#1E1E2E"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    Click="BtnDiagnostic_Click"/>
        </StackPanel>

        <!-- Host Panel -->
        <StackPanel x:Name="PanelHost"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="550">
            <TextBlock Text="Crear Partida (Host)"
                       Foreground="#CDD6F4"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Border Background="#313244"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <TextBlock x:Name="TxtHostInstruction"
                           Style="{StaticResource StatusText}"
                           Text="Para crear una partida, asegúrate de haber abierto el puerto 6000 (UDP y TCP) en la configuración de tu router (Port Forwarding). Tu IP pública actual es: Obteniendo... Compártela con tu amigo."/>
            </Border>

            <TextBlock x:Name="TxtHostStatus"
                       Style="{StaticResource StatusText}"
                       HorizontalAlignment="Center"
                       Text=""/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <Button x:Name="BtnStartHost"
                        Content="Iniciar Host"
                        Style="{StaticResource AccentButton}"
                        Click="BtnStartHost_Click"/>

                <Button Content="Volver"
                        Margin="16,0,0,0"
                        Style="{StaticResource AccentButton}"
                        Background="#585B70"
                        Click="BtnBack_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Client Panel -->
        <StackPanel x:Name="PanelClient"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="550">
            <TextBlock Text="Unirse a Partida"
                       Foreground="#CDD6F4"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Border Background="#313244"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <TextBlock Style="{StaticResource StatusText}"
                           Text="Ingresa la dirección IP que te dio tu amigo para conectarte a su partida."/>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                <TextBox x:Name="TxtHostIp"
                         Width="300"
                         Height="36"
                         FontSize="16"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Background="#45475A"
                         Foreground="#CDD6F4"
                         BorderBrush="#585B70"
                         CaretBrush="#CDD6F4"/>

                <Button x:Name="BtnConnect"
                        Content="Conectar"
                        Style="{StaticResource AccentButton}"
                        Margin="12,0,0,0"
                        Click="BtnConnect_Click"/>
            </StackPanel>

            <TextBlock x:Name="TxtClientStatus"
                       Style="{StaticResource StatusText}"
                       HorizontalAlignment="Center"
                       Text=""/>

            <Button Content="Volver"
                    Margin="0,12,0,0"
                    Style="{StaticResource AccentButton}"
                    Background="#585B70"
                    HorizontalAlignment="Center"
                    Click="BtnBack_Click"/>
        </StackPanel>
        <!-- Diagnostics Panel -->
        <Grid x:Name="PanelDiagnostics"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Validación de Requisitos"
                       Foreground="#CDD6F4"
                    FontSize="24"
                    FontWeight="Bold"
                       HorizontalAlignment="Center"
                    Margin="0,20,0,10"
                       Grid.Row="0"/>

            <ScrollViewer Grid.Row="1"
                    Margin="30,0,30,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DiagnosticsResults"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                        HorizontalAlignment="Center"
                    Margin="0,12,0,20">
                <Button x:Name="BtnRerunDiagnostic"
                        Content="Volver a Validar"
                        Style="{StaticResource AccentButton}"
                        Background="#F9E2AF"
                        Foreground="#1E1E2E"
                        Click="BtnDiagnostic_Click"/>

                <Button Content="Volver"
                        Margin="16,0,0,0"
                        Style="{StaticResource AccentButton}"
                        Background="#585B70"
                        Click="BtnBackFromDiag_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
